# Kiro spec documents (requirements.md, design.md, tasks.md, config) — not shipped
.kiro/

# Large training checkpoints (full model state dicts) — keep the dir, drop contents
checkpoints/*
!checkpoints/.gitkeep

# Saved adapter binaries produced by experiment runs (reproducible artifacts)
results/experiment*_*/

# Runtime logs — keep the dir, drop contents
logs/*
!logs/.gitkeep

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# OS / editor cruft
.DS_Store
Thumbs.db
